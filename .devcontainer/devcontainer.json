{
    "name": "Java 21",
    "image": "mcr.microsoft.com/devcontainers/java:21",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "installGradle": "true",
            "gradleVersion": "latest"
        }
    },
    "postCreateCommand": {
        "asciidoctor": "sudo apt -y update && sudo apt -y install ruby-asciidoctor-pdf fonts-dejavu-core fonts-dejavu-extra"
    },
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "mhutchie.git-graph",
                "antfu.slidev",
                "vue.volar",
                "asciidoctor.asciidoctor-vscode",
                "tomoki1207.pdf",
                "r0kuko.vscode-gradle-kotlin"
            ]
        },
        "settings": {
            "asciidoc.pdf.asciidoctorPdfCommandArgs": [
                "-r",
                "/workspaces/webdevelopment/.asciidoctor/lib/list_colors.rb"
            ],
            "asciidoc.pdf.asciidoctorPdfCommandPath": "/usr/bin/asciidoctor-pdf"
        }
    },
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "node",
    // "updateRemoteUserUID": true,
    "runArgs": ["--dns=8.8.8.8", "--dns=8.8.4.4"],
    "remoteUser": "root"
}
